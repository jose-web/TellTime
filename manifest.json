{
    "manifest_version": 3,
    "name": "TellTime",
    "description": "This extension tells the time in a robot voice.",
    "version": "1.0",
    "icons": {
        "128": "128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "128": "128.png"
        }
    },
    "permissions": [
        "alarms",
        "tts",
        "storage"
    ]
}
